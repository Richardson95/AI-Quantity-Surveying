# Paystack ------------------------------------------------------------------
# Public key is safe in the browser bundle. Never put the secret key here.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server only. Set this in Vercel -> Settings -> Environment Variables.
# It must NOT be prefixed with VITE_, or Vite would ship it to the browser.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Analysis engine ------------------------------------------------------------
# There is no separate analysis host any more. The engine lives inside the
# BuildQ backend and is reached through VITE_API_URL below, on the same
# authenticated session as everything else. See src/services/analysis.js.

# BuildQ backend -------------------------------------------------------------
# Base URL of the BuildQ API. Unset = the app runs on its localStorage demo
# data with no server, exactly as before.
#
# In development leave this as the relative path: vite.config.js proxies /api to
# the backend, which keeps the app and API same-origin so the httpOnly refresh
# cookie works. Override the proxy target with BUILDQ_API_TARGET if the backend
# is not on http://localhost:4000.
VITE_API_URL=/api/buildq

# In production point this at the deployed service, e.g.
# VITE_API_URL=https://api.brgprime.com/api/buildq
