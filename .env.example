# Paystack ------------------------------------------------------------------
# Public key is safe in the browser bundle. Never put the secret key here.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server only. Set this in Vercel -> Settings -> Environment Variables.
# It must NOT be prefixed with VITE_, or Vite would ship it to the browser.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Analysis engine ------------------------------------------------------------
# Base URL of the backend that reads drawings and returns measured quantities.
# Leave unset until it exists: the app then falls back to template figures and
# labels them as such in the UI. See src/services/analysis.js for the contract.
VITE_ANALYSIS_API_URL=
